# Django Configuration
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# For SQLite (Development)
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL (Production)
# DATABASE_URL=postgresql://username:password@localhost:5432/ecopredict_db

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# External API Keys (Optional - for future integrations)
# WEATHER_API_KEY=your-weather-api-key
# OPENAI_API_KEY=your-openai-api-key
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Generative AI / Gemini model
# GEMINI_API_KEY=your-google-generative-ai-key
# Optional: specify the model name your key supports (if not set the server will try to auto-select)
# GEMINI_MODEL=gemini-1.5

# Email Configuration (Optional)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-email-password

# Redis Configuration (Optional - for caching)
# REDIS_URL=redis://localhost:6379/0
